# The complete app environment under test. Applied by tests/preload.ts inside
# every worker, so a developer's real .env (inherited by mutation-testing
# workers spawned from an already-.env-loaded parent process) can never win —
# `bun test --env-file` alone can't unset a key the process already has, it
# only adds ones that aren't set yet.
#
#   KEY=value    present with this value
#   KEY=@absent  deliberately unset — preload deletes it, so `!== undefined`
#                checks (awsConfigured, stripeConfigured) see it missing
#
# Every variable src/lib/config.ts or src/lib/public-config.ts reads must
# appear here.

ENVIRONMENT=@absent
LOG_LEVEL=error
LOG_DRAIN_URL=@absent
SCHEME=http
AUTHORITY=localhost:3000

GITHUB_CLIENT_ID=@absent
GITHUB_CLIENT_SECRET=@absent
GOOGLE_CLIENT_ID=@absent
GOOGLE_CLIENT_SECRET=@absent

AWS_REGION=@absent
AWS_ACCESS_KEY_ID=@absent
AWS_SECRET_ACCESS_KEY=@absent
FROM_EMAIL_ADDRESS=@absent

STRIPE_SECRET_KEY=@absent
STRIPE_WEBHOOK_SECRET=@absent
STRIPE_PORTAL_RETURN_URL=@absent

# @catalyst:redis-start
# Present so `redisConfigured` is true: the suite exercises the configured
# path. Redis itself is never reached — the client is created with lazyConnect.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASS=test-redis-password-placeholder
# @catalyst:redis-end

# @catalyst:auth-start
AUTH_REDIRECT_PATH=@absent
TURNSTILE_SECRET_KEY=test-turnstile-secret
TURNSTILE_SITEKEY=@absent
# @catalyst:auth-end

GOOGLE_ANALYTICS_ID=@absent
GOOGLE_TAG_MANAGER_ID=@absent
GOOGLE_ADS_ID=@absent
CLARITY_ID=@absent
