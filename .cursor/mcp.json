{
  "mcpServers": {
    "catalyst-dev": {
      "type": "http",
      "url": "http://localhost:3000/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CATALYST_MCP_KEY_DEV}"
      }
    },
    "catalyst-stage": {
      "type": "http",
      "url": "https://stage.example.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CATALYST_MCP_KEY_STAGE}"
      }
    },
    "catalyst-prod": {
      "type": "http",
      "url": "https://example.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CATALYST_MCP_KEY_PROD}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--output-dir",
        ".playwright-mcp"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    }
  }
}
