{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "catalyst-dev": {
      "type": "remote",
      "url": "http://localhost:3000/api/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CATALYST_MCP_KEY_DEV}"
      }
    },
    "catalyst-stage": {
      "type": "remote",
      "url": "https://stage.example.com/api/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CATALYST_MCP_KEY_STAGE}"
      }
    },
    "catalyst-prod": {
      "type": "remote",
      "url": "https://example.com/api/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CATALYST_MCP_KEY_PROD}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--output-dir",
        ".playwright-mcp"
      ],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ],
      "enabled": true
    }
  }
}
